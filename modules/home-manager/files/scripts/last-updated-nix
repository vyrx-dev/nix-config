#!/usr/bin/env bash
# Days since the last `nix flake update`. Reads the mtime of flake.lock, which
# is rewritten only by update commands, not by rebuilds.

lock="/etc/nixos/flake.lock"

ts=$(stat -c %Y "$lock" 2>/dev/null)

if [ -z "$ts" ]; then
	printf '{"text":"?","class":"critical","tooltip":"no flake.lock"}\n'
	exit 0
fi

now=$(date +%s)
days=$(((now - ts) / 86400))

if [ "$days" -lt 7 ]; then
	class="ok"
elif [ "$days" -lt 14 ]; then
	class="warning"
else
	class="critical"
fi

printf '{"text":"%sd","class":"%s","tooltip":"last flake update: %s (%sd ago)"}\n' \
	"$days" "$class" "$(date -d @"$ts" '+%a %d %b %Y %H:%M')" "$days"
